# Supabase project (Auth with Google, Postgres, private storage). Local stack: `supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never shipped to the browser; used for the sign-in bootstrap and invitation lookup
SUPABASE_SERVICE_ROLE_KEY=

# the company sign-in path: only accounts on this Google Workspace domain may sign in without an invitation
COMPANY_DOMAIN=mosaicintelligence.xyz
# comma-separated company addresses that become owners of every presentation on their first sign-in
OWNER_EMAILS=

# where drafts and versions live: "supabase" (the default when the keys above are set) or "file" for the
# offline, unauthenticated local mode under apps/web/data (never in production)
ITW_STORE=supabase

# test only: enables POST /auth/test-sign-in (email + password) for the browser tests; refused in production
ITW_TEST_AUTH=0
