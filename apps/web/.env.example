# The presentations app — environment. Copy to .env.local for a local run (the local stack: `supabase start` prints
# the URL and keys); set the same names on the host.
# Public (inlined into the browser bundle at build time — the build must have them):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the project's anon key>
# Secret (server only; never in the browser, never in chat or a commit):
SUPABASE_SERVICE_ROLE_KEY=<the project's service role key>
# Who holds the seeded decks from the first sign-in (comma-separated). Everyone else needs an invitation.
OWNER_EMAILS=nancy@mosaicintelligence.xyz
# Accounts on this domain may sign in without an invitation (they still hold no role until granted one).
COMPANY_DOMAIN=mosaicintelligence.xyz
# Where drafts and versions live: "supabase" (the default when the keys above are set) or "file" for the offline,
# unauthenticated local mode under apps/web/data — never in production.
ITW_STORE=supabase
# Local only — never on the host: password sign-in for the browser tests (refused in production).
# ITW_TEST_AUTH=1
